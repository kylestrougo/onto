# Copy to backend/.env and fill in. Never commit the real file.

# ── Core ───────────────────────────────────────────────────────────────
# Pin this, or the app generates one next to the DB (restarts stay logged in
# either way, but pinning is tidier).
ONTO_SECRET_KEY=
ONTO_DB=/home/io/onto/onto.db
ONTO_PUBLIC_URL=https://onto.example.com
# Where completion photos are stored (kept next to the DB so backups travel
# together).
ONTO_UPLOAD_DIR=/home/io/onto/uploads

# Set to 0 only for local http development — a Secure cookie is never sent
# over plain http, which presents as "the app silently can't log anyone in".
ONTO_COOKIE_SECURE=1

# ── OpenRouter ─────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-...
# Per-request timeout and the hard ceiling on one generation across the whole
# fallback chain. Defaults (45 / 60) suit free models.
#OPENROUTER_TIMEOUT=45
#ONTO_GENERATION_BUDGET=60
# Starting fallback chain. The free list churns — re-pick from /admin.
ONTO_MODEL_CHAIN=meta-llama/llama-3.3-70b-instruct:free,google/gemma-2-9b-it:free,mistralai/mistral-7b-instruct:free

# ── Abuse guards ───────────────────────────────────────────────────────
ONTO_SIGNUP_CAP_IP=5
ONTO_DAILY_CAP_USER=300

# ── Admin ──────────────────────────────────────────────────────────────
# The first account created with this username becomes the single admin.
ONTO_ADMIN_USERNAME=kyle

# ── Email (Gmail SMTP + app password) ──────────────────────────────────
# The port picks the transport — 465 is implicit TLS, 587 opens in clear and
# upgrades via STARTTLS. Gmail accepts both; they are not interchangeable.
ONTO_SMTP_HOST=smtp.gmail.com
ONTO_SMTP_PORT=465
ONTO_SMTP_USER=you@gmail.com
ONTO_SMTP_PASSWORD=your-16-char-app-password
ONTO_MAIL_FROM=you@gmail.com
ONTO_MAIL_FROM_NAME=Onto
# Print emails to the log instead of sending. Useful on first deploy.
ONTO_MAIL_DRY_RUN=0
# Fallback timezone for accounts whose browser never reported one.
# IANA name, e.g. America/New_York.
ONTO_DEFAULT_TZ=America/New_York

# ── Event discovery ────────────────────────────────────────────────────
# Self-hosted SearXNG instance for scheduled LLM web research (tier 3
# sources). Leave empty to disable tier-3 research; tier 1/2 ingest still runs.
ONTO_SEARXNG_URL=
# City the shared event corpus covers.
ONTO_CITY=NYC
