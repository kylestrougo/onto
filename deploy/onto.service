[Unit]
Description=Onto — a weekly planner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=io
Group=io
WorkingDirectory=/home/io/onto/backend
EnvironmentFile=/home/io/onto/backend/.env

# Waitress rather than gunicorn: smaller resident footprint, and threads are
# the right model here since the slow requests are I/O-bound on OpenRouter.
# 4 threads is plenty for an app serving friends and keeps RSS small.
ExecStart=/home/io/onto/backend/.venv/bin/waitress-serve \
    --listen=127.0.0.1:5000 \
    --threads=4 \
    --call wsgi:build

Restart=on-failure
RestartSec=5

# The Pi has 1GB shared with other services. Fail loudly rather than swap.
MemoryMax=200M

# Hardening — this process only needs its own directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/io/onto
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=onto

[Install]
WantedBy=multi-user.target
